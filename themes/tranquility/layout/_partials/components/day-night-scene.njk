{# 「昼夜鹿鸣」：麋鹿在湖边低头饮水，日月轮转、昼夜交替。
    纯 SVG + CSS 动画，30s 一个循环（周期统一在 index.styl 的 $scene-cycle）。
    画布 1600×640 贴合首屏横幅比例（preserveAspectRatio: slice 只裁左右不裁上下）；
    麋鹿站在浅滩，低头姿态（绕肩点 rotate(-82)）鼻尖恰好触及水面涟漪处。
    低头动作 = 抬头/低头两组同源姿态交叉淡入，避开 CSS transform-origin 的跨浏览器差异。
    静态兜底：prefers-reduced-motion 或动画被禁时停在白昼一帧（base 样式即白昼）。 #}
<svg class="wall-scene"
     viewBox="0 0 1600 640"
     preserveAspectRatio="xMidYMid slice"
     aria-hidden="true"
     focusable="false">
  <defs>
    <linearGradient id="skyDay" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#c9ddec"/>
      <stop offset="0.72" stop-color="#e9efe3"/>
      <stop offset="1" stop-color="#f4ecd9"/>
    </linearGradient>
    <linearGradient id="skyDusk" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8d7fae"/>
      <stop offset="0.55" stop-color="#c98f8a"/>
      <stop offset="1" stop-color="#f0bf8a"/>
    </linearGradient>
    <linearGradient id="skyNight" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#101828"/>
      <stop offset="0.6" stop-color="#1d2a44"/>
      <stop offset="1" stop-color="#2e3d58"/>
    </linearGradient>
    <linearGradient id="waterGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3a4b60"/>
      <stop offset="1" stop-color="#1c2738"/>
    </linearGradient>
    <radialGradient id="sunGlow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#ffdf9e" stop-opacity="0.9"/>
      <stop offset="0.35" stop-color="#ffce7a" stop-opacity="0.45"/>
      <stop offset="1" stop-color="#ffce7a" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="moonGlow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#e6edfa" stop-opacity="0.8"/>
      <stop offset="0.4" stop-color="#dbe4f4" stop-opacity="0.3"/>
      <stop offset="1" stop-color="#dbe4f4" stop-opacity="0"/>
    </radialGradient>
    {# 月牙：mask 从满月上咬掉一块，咬合色不随天空渐变 #}
    <mask id="crescent">
      <circle cx="-17" cy="-9" r="30" fill="#fff"/>
      <circle cx="2" cy="-16" r="27" fill="#000"/>
    </mask>
  </defs>

  {# —— 天空：三层渐变交叉淡入，水线 y=450 —— #}
  <rect class="sky sky--day" x="0" y="0" width="1600" height="450" fill="url(#skyDay)"/>
  <rect class="sky sky--dusk" x="0" y="0" width="1600" height="450" fill="url(#skyDusk)"/>
  <rect class="sky sky--night" x="0" y="0" width="1600" height="450" fill="url(#skyNight)"/>

  {# —— 星星：只属于夜空 —— #}
  <g class="stars" fill="#dde6f4">
    <circle cx="230" cy="90" r="2"/>
    <circle cx="430" cy="60" r="1.6"/>
    <circle cx="620" cy="120" r="2.2"/>
    <circle cx="790" cy="50" r="1.8"/>
    <circle cx="980" cy="105" r="2"/>
    <circle cx="1170" cy="70" r="1.7"/>
    <circle cx="1330" cy="135" r="2.1"/>
    <circle cx="1470" cy="85" r="1.6"/>
    <circle cx="330" cy="195" r="1.5"/>
    <circle cx="910" cy="180" r="1.6"/>
    <circle cx="1260" cy="225" r="1.4"/>
    <circle cx="540" cy="240" r="1.5"/>
  </g>

  {# —— 日 / 月：同一条东升西落的弧，各走半个周期 —— #}
  <g class="sun">
    <circle cx="0" cy="0" r="120" fill="url(#sunGlow)"/>
    <circle cx="0" cy="0" r="42" fill="#f5bb60"/>
  </g>
  <g class="moon">
    <circle cx="0" cy="0" r="100" fill="url(#moonGlow)"/>
    <circle cx="-17" cy="-9" r="30" fill="#e9eef7" mask="url(#crescent)"/>
  </g>

  {# —— 云：只在白昼现身 —— #}
  <g class="cloud" fill="#ffffff">
    <ellipse cx="520" cy="152" rx="128" ry="22"/>
    <ellipse cx="632" cy="161" rx="88" ry="16"/>
  </g>

  {# —— 远山两层 —— #}
  <polygon class="hill hill--back" points="0,450 0,390 180,340 360,390 520,362 700,404 900,375 1100,418 1300,382 1600,425 1600,450"/>
  <polygon class="hill hill--front" points="0,450 0,422 260,397 520,436 800,410 1080,443 1350,415 1600,437 1600,450"/>

  {# —— 湖面 —— #}
  <rect x="0" y="450" width="1600" height="190" fill="url(#waterGrad)"/>
  <rect class="shimmer shimmer--1" x="240" y="505" width="420" height="3" rx="1.5"/>
  <rect class="shimmer shimmer--2" x="900" y="548" width="520" height="3" rx="1.5"/>
  <rect class="shimmer shimmer--3" x="520" y="595" width="380" height="3" rx="1.5"/>
  <ellipse class="glint glint--sun" cx="800" cy="478" rx="130" ry="8"/>
  <ellipse class="glint glint--moon" cx="820" cy="478" rx="110" ry="7"/>

  {# —— 前景浅滩（托住鹿蹄，兽高约四分之一没入水线以下） —— #}
  <path class="bank"
        d="M280,640 L360,540 Q450,500 560,520 Q640,535 660,640 Z"/>

  {# —— 麋鹿：脖颈+头定义一次，抬头/低头两份姿态交叉淡入。
       坐标系：地面 y=660，肩点 (120,470)；低头姿态绕肩点转 -93°，
       鼻尖恰好落在浅滩水线（frame y=450，对应本地 y≈554）。 —— #}
  {% set neck %}
    <g class="deer-fill deer--near">
      {# 脖颈（粗胶囊，自肩点伸向左上） #}
      <path d="M-10,20 C-24,-16 -34,-64 -26,-104 C-20,-134 0,-146 24,-138 L34,-106 C24,-72 -2,-22 -10,20 Z"/>
      {# 头部与口鼻 #}
      <path d="M-18,-120 C-44,-128 -68,-118 -74,-102 C-78,-90 -68,-80 -54,-80 C-40,-80 -26,-84 -16,-88 C-6,-92 -4,-114 -18,-120 Z"/>
      {# 耳朵 #}
      <path d="M-12,-118 L8,-146 L-2,-110 Z"/>
      {# 大角：主干 + 蹄尖，粗描边圆头 #}
      <path class="deer-antler" d="M-8,-122 C-22,-162 -46,-186 -76,-192 M-32,-152 L-38,-178 M-50,-168 L-62,-190"/>
      <path class="deer-antler" d="M0,-124 C0,-164 14,-190 40,-202 M12,-164 L22,-186 M26,-182 L38,-200 M4,-146 L14,-168"/>
    </g>
  {% endset %}
  <g class="deer" transform="translate(430,35) scale(0.75)">
    {# 远侧腿（浅一档，做前后景深） #}
    <path class="deer-fill deer--far" d="M158,505 C155,555 153,608 153,660 L164,660 C165,610 167,558 170,507 Z"/>
    <path class="deer-fill deer--far" d="M244,660 C244,625 245,590 248,570 C256,556 262,540 266,502 C262,538 258,556 253,572 C250,592 249,625 249,660 Z"/>
    {# 抬头姿态（默认）与低头姿态 #}
    <g transform="translate(120,470)"><g class="deer-neck deer-neck--up">{{ neck }}</g></g>
    <g transform="translate(120,470) rotate(-93)"><g class="deer-neck deer-neck--down">{{ neck }}</g></g>
    {# 躯干 #}
    <path class="deer-fill deer--near"
          d="M115,470 C110,440 130,418 170,412 C220,405 275,412 308,432 C328,444 332,470 320,488 C306,506 270,514 230,514 C195,514 160,508 138,496 C122,487 111,481 115,470 Z"/>
    {# 近侧腿：前直后曲（跗关节） #}
    <path class="deer-fill deer--near" d="M130,505 C126,560 124,610 124,660 L138,660 C138,610 140,560 142,508 Z"/>
    <path class="deer-fill deer--near" d="M283,660 C283,625 284,595 288,575 C297,559 304,538 300,500 C305,536 304,560 296,578 C293,598 293,625 293,660 Z"/>
    {# 尾巴 #}
    <path class="deer-fill deer--near" d="M318,440 C334,448 340,462 334,476 C326,470 318,458 314,448 Z"/>
  </g>

  {# —— 饮水涟漪（白昼一次、夜晚一次）：椭圆环放大淡出 —— #}
  <ellipse class="ripple ripple--day" cx="451" cy="452" rx="34" ry="6"/>
  <ellipse class="ripple ripple--night" cx="451" cy="452" rx="34" ry="6"/>
</svg>
