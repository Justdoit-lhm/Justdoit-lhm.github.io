@import '_variables';

$anchor-border = $gainsboro; /* get timeline color config from __config.yml */
timeline_colors = {};

for item in hexo-config('timeline.items') {
  for key in item {
    if (key[0] == 'name') {
      c_name = key[1];
    }

    if (key[0] == 'color') {
      c_value = key[1];
    }
  }

  timeline_colors[c_name] = c_value;
}

.wall-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.wall-bg::before {
  @extend .wall-bg;
  z-index: 2;
  content: ' ';
  /* 背景是「昼夜鹿鸣」动画：面纱只负责压住画面保证标题可读，
     留出足够透明度让昼夜交替清晰可见（见下方 .wall-scene）。 */
  background-color: rgba(255, 255, 255, 0.6);
  transition: background-color 150ms ease;
}

/* 静止时画面退为水彩般的底子，悬停时揭开幕布看完整动画；触屏没有
   hover，取一个折中透明度。 */
@media (hover: hover) and (pointer: fine) {
  .wall-main:hover+.wall-bg::before {
    background-color: rgba(255, 255, 255, 0.32);
  }
}

@media (hover: none) {
  .wall-bg::before {
    background-color: rgba(255, 255, 255, 0.5);
  }
}

.wall-main {
  position: relative;
  text-align: center;
  z-index: 3;
}

/* Only the home cover keeps a floor; category and moments pages reuse
   .wall for their header and must stay content-sized. */
.wall-index {
  min-height: 440px;
}

.wall-title {
  font-weight: 600;
  font-size: clamp(2.25rem, 7.2vw, 4.5rem);
  line-height: 1.15;
  overflow-wrap: anywhere;
  animation: flyIn 320ms $ease-out;
  /* 夜空帧下背景偏深，白色光晕保证标题始终可读。 */
  text-shadow: 0 1px 2px rgba(255, 255, 255, 0.9), 0 2px 20px rgba(255, 255, 255, 0.8);
}

.wall-subtitle {
  font-size: clamp(1.15rem, 3.4vw, 2.25rem);
  font-weight: bold;
  margin-top: 10px;
  text-shadow: 0 1px 2px rgba(255, 255, 255, 0.9), 0 2px 20px rgba(255, 255, 255, 0.8);
}

.wall-description {
  font-size: clamp(0.9rem, 2vw, 1.25rem);
  font-weight: 400;
  margin: 10px 0;
  font-family: $font-family-serif;
  letter-spacing: 0.2em;
}

/* ------------------------------------------------------------------ *
 * 昼夜壁纸（day-night-scene.njk）：SVG 场景 + CSS 动画。
 * 一个循环 $scene-cycle：破晓 → 白昼 → 暮色 → 星夜，昼夜各饮一次水。
 * 所有时序都在 keyframes 百分位里，改周期只改 $scene-cycle 一处。
 * ------------------------------------------------------------------ */
$scene-cycle = 30s;

.wall-scene {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: block;
  width: 100%;
  height: 100%;
}

/* —— 基色：同时是动画被禁用时的静态白昼帧 —— */
.hill--back { fill: #8fa5b8; }
.hill--front { fill: #66788c; }
.bank { fill: #2b3648; }
.shimmer { fill: #aebfd4; opacity: 0.08; }
.glint--sun { fill: #ffe6bd; opacity: 0.4; }
.glint--moon { fill: #cfd9ec; opacity: 0; }
.deer--near { fill: #222c3a; }
.deer--far { fill: #3a4656; }
.deer-antler {
  fill: none;
  stroke: #222c3a;
  stroke-width: 9;
  stroke-linecap: round;
}

/* —— 天空：暮色与星夜两层在固定时刻盖上来 —— */
.sky--dusk,
.sky--night {
  opacity: 0;
}

.sky--dusk { animation: sceneDusk $scene-cycle linear infinite; }
.sky--night { animation: sceneNight $scene-cycle linear infinite; }
.stars { opacity: 0; animation: sceneStars $scene-cycle linear infinite; }

/* —— 日 / 月：同一条东升西落的弧 —— */
.sun {
  transform: translate(700px, 240px);
  animation: sunTrack $scene-cycle linear infinite;
}

.moon {
  opacity: 0;
  animation: moonTrack $scene-cycle linear infinite;
}

/* —— 云只在白昼现身 —— */
.cloud { animation: cloudShow $scene-cycle linear infinite; }

/* —— 湖面微光与日月倒影 —— */
.shimmer--1 { animation: shimmer 8s ease-in-out infinite; }
.shimmer--2 { animation: shimmer 8s ease-in-out infinite -2.6s; }
.shimmer--3 { animation: shimmer 8s ease-in-out infinite -5.2s; }
.glint--sun { animation: glintSun $scene-cycle linear infinite; }
.glint--moon { animation: glintMoon $scene-cycle linear infinite; }

/* —— 麋鹿：抬头/低头两份姿态交叉淡入 —— */
.deer-neck--up { animation: neckUp $scene-cycle linear infinite; }
.deer-neck--down { opacity: 0; animation: neckDown $scene-cycle linear infinite; }

/* —— 涟漪：以自身中心放大淡出 —— */
.ripple {
  fill: none;
  stroke: #d8e2ee;
  stroke-width: 2;
  opacity: 0;
  transform: scale(0.15);
  transform-box: fill-box;
  transform-origin: center;
}

.ripple--day { animation: rippleDay $scene-cycle linear infinite; }
.ripple--night { animation: rippleNight $scene-cycle linear infinite; }

@media (prefers-reduced-motion: reduce) {
  .wall-scene,
  .wall-scene * {
    animation: none !important;
  }
}

/* The couplet runs down the right margin as a vertical inscription, the way
   it would sit on a scroll. Reading order stays right-to-left. It only has
   room to clear the headline once the cover is wider than 1200px. */
.poem {
  position: absolute;
  top: 50%;
  right: 24px;
  transform: translateY(-50%);
  writing-mode: vertical-rl;
  font-family: $font-family-serif;
  font-size: 21px;
  letter-spacing: 0.32em;
  line-height: 1.6;
  color: $black-lighter;
  opacity: 0.85;
}

@media screen and (max-width: 1279px) {
  .poem {
    display: none;
  }
}

.poem__line {
  display: block;
}

/* Bottom-left signature: a hairline, then the motto in wide tracking. */
.motto {
  position: absolute;
  left: 6vw;
  bottom: 12%;
  font-family: $font-family-serif;
  font-size: 14px;
  letter-spacing: 0.34em;
  color: $black-light;
  text-shadow: 0 1px 2px rgba(255, 255, 255, 0.85), 0 2px 14px rgba(255, 255, 255, 0.75);

  &::before {
    content: '';
    display: block;
    width: 34px;
    height: 1px;
    margin-bottom: 12px;
    background-color: $grey-light;
  }
}

/* —— 昼夜壁纸 keyframes（百分位 = 30s 内的时刻） —— */
@keyframes sceneDusk {
  0% { opacity: 1; }
  7% { opacity: 0; }
  40% { opacity: 0; }
  47% { opacity: 1; }
  55% { opacity: 0; }
  88% { opacity: 0; }
  96% { opacity: 1; }
  100% { opacity: 1; }
}

@keyframes sceneNight {
  0% { opacity: 0; }
  42% { opacity: 0; }
  50% { opacity: 1; }
  88% { opacity: 1; }
  97% { opacity: 0; }
  100% { opacity: 0; }
}

@keyframes sceneStars {
  0% { opacity: 0; }
  48% { opacity: 0; }
  54% { opacity: 1; }
  84% { opacity: 1; }
  92% { opacity: 0; }
  100% { opacity: 0; }
}

@keyframes sunTrack {
  0% { transform: translate(120px, 560px); opacity: 0; }
  4% { transform: translate(300px, 330px); opacity: 1; }
  25% { transform: translate(800px, 85px); opacity: 1; }
  44% { transform: translate(1340px, 330px); opacity: 1; }
  49% { transform: translate(1540px, 580px); opacity: 1; }
  51% { transform: translate(1540px, 580px); opacity: 0; }
  100% { transform: translate(1540px, 580px); opacity: 0; }
}

@keyframes moonTrack {
  0% { transform: translate(160px, 580px); opacity: 0; }
  49% { transform: translate(160px, 580px); opacity: 0; }
  53% { transform: translate(320px, 360px); opacity: 1; }
  75% { transform: translate(820px, 95px); opacity: 1; }
  93% { transform: translate(1360px, 360px); opacity: 1; }
  99% { transform: translate(1540px, 580px); opacity: 1; }
  100% { transform: translate(1540px, 580px); opacity: 0; }
}

@keyframes cloudShow {
  0% { transform: translateX(-40px); opacity: 0; }
  10% { transform: translateX(0); opacity: 0.55; }
  38% { transform: translateX(70px); opacity: 0.55; }
  47% { transform: translateX(110px); opacity: 0; }
  100% { transform: translateX(110px); opacity: 0; }
}

@keyframes shimmer {
  0% { opacity: 0.08; }
  50% { opacity: 0.16; }
  100% { opacity: 0.08; }
}

@keyframes glintSun {
  0% { opacity: 0; }
  8% { opacity: 0; }
  14% { opacity: 0.4; }
  36% { opacity: 0.4; }
  44% { opacity: 0; }
  100% { opacity: 0; }
}

@keyframes glintMoon {
  0% { opacity: 0; }
  52% { opacity: 0; }
  58% { opacity: 0.45; }
  84% { opacity: 0.45; }
  92% { opacity: 0; }
  100% { opacity: 0; }
}

@keyframes neckUp {
  0% { opacity: 1; }
  16% { opacity: 1; }
  19% { opacity: 0; }
  26% { opacity: 0; }
  29% { opacity: 1; }
  64% { opacity: 1; }
  67% { opacity: 0; }
  74% { opacity: 0; }
  77% { opacity: 1; }
  100% { opacity: 1; }
}

@keyframes neckDown {
  0% { opacity: 0; }
  16% { opacity: 0; }
  19% { opacity: 1; }
  26% { opacity: 1; }
  29% { opacity: 0; }
  64% { opacity: 0; }
  67% { opacity: 1; }
  74% { opacity: 1; }
  77% { opacity: 0; }
  100% { opacity: 0; }
}

@keyframes rippleDay {
  0% { transform: scale(0.15); opacity: 0; }
  18% { transform: scale(0.15); opacity: 0; }
  22% { transform: scale(0.9); opacity: 0.5; }
  29% { transform: scale(1.5); opacity: 0; }
  100% { transform: scale(1.5); opacity: 0; }
}

@keyframes rippleNight {
  0% { transform: scale(0.15); opacity: 0; }
  65% { transform: scale(0.15); opacity: 0; }
  69% { transform: scale(0.9); opacity: 0.5; }
  76% { transform: scale(1.5); opacity: 0; }
  100% { transform: scale(1.5); opacity: 0; }
}

@keyframes flyIn {
  from {
    transform: translateY(-100%);
    opacity: 0;
  }

  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 首页“关于”区：单栏纯文字。主题原本是「照片 + 短文」两栏，既然不放照片，
   改成窄栏居中的行文排版，靠字号与行距撑起留白，而不是靠一列占位。 */
.about {
  max-width: 720px;
  /* The hero already ends the first screen, so the section only needs a
     breathing gap, not another 200px of blank paper. */
  margin: 120px auto 160px;
  padding: 0 24px;
}

.about-title {
  text-align: center;
  font-size: 40px;
  font-weight: bold;
  margin: 0 0 48px;
}

.about-body {
  font-size: $font-size-base;
  line-height: 2.1;
  letter-spacing: 0.08em;
  font-weight: bold;
  font-family: $font-family-serif;
  /* 中英混排时两端对齐会在西文单词处拉出明显字距，左对齐更稳。 */
  text-align: left;
}

.about-body-p {
  margin: 0 0 0.9em;
  text-indent: 2em;

  &:last-child {
    margin-bottom: 0;
  }
}

/* Link from the cover timeline to the full list. */
.timeline-more {
  margin-top: 48px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 18px;
  border: 1px solid $grey-lighter;
  border-radius: 999px;
  color: $black-light;
  font-size: 14px;
  text-decoration: none;
  transition: background-color 150ms ease, border-color 150ms ease,
    color 150ms ease, transform 140ms $ease-out;

  @media (hover: hover) and (pointer: fine) {
    &:hover {
      color: $blue-link;
      border-color: $grey-light;
      background-color: $white-blue-lightest;
    }
  }

  &:active {
    transform: scale(0.97);
  }
}

.timeline-more__count {
  color: $grey-dark;
  font-variant-numeric: tabular-nums;
  margin: 0 2px 0 6px;
}

/* /timeline/: the same section, without the cover's giant top margin. */
.timeline-page {
  max-width: 1100px;
  margin: 70px auto 120px;
  padding: 0 20px;

  .timeline {
    margin: 40px auto 0;
  }
}

.timeline-page__title {
  font-size: 40px;
  font-family: $font-family-serif;
  text-align: center;
  margin: 0;
}

.timeline-page__lead {
  margin: 12px 0 0;
  text-align: center;
  color: $black-extra-lighter;
  font-size: 15px;
}

.timeline {
  max-width: 1100px;
  margin: 200px auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.timeline-head {
  display: flex;
  justify-content: center;
  align-items: center;
}

.timeline-head .title {
  font-size: 40px;
  font-weight: bold;
}

.radio-wrapper {
  display: flex;
  align-items: flex-end;
  margin: 0 10px;
}

.radio {
  position: relative;
  width: 20px;
  margin: 0 10px;
  height: 40px;
}

.radio>label {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  height: 100%;
  margin: auto;
}

.radio>input {
  position: absolute;
  opacity: 0;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  height: 100%;
  margin: auto;
}

.radio-skin {
  height: 100%;
  width: 2px;
  border-radius: 1px;
  background: #ccc;
  transition: background-color 180ms ease;

  &::after {
    transition: background-color 180ms ease, transform 180ms $ease-out;
    display: block;
    height: 20px;
    width: 20px;
    border-radius: 50%;
    background-color: #fafafa;
    border: 2px solid transparent;
    box-sizing: border-box;
    content: '';
    position: absolute;
    left: -9px;
    top: 22px;
    box-shadow: 1px 0 5px rgba(0, 0, 0, 0.2);
  }
}

for v, k in timeline_colors {
  .radio-skin--{v} {
    @extend .radio-skin;

    &::after {
      border-color: convert(k);
    }
  }

  #radio-{v}:checked+.radio-skin--{v} {
    background-color: convert(k);

    &::after {
      background-color: convert(k);
      transform: translateY(-24px);
    }
  }

  .timeline-item-{v}, .timeline-item-{v}--hidden {
    .line-anchor::after {
      background-color: convert(k);
    }

    .line-date-tag {
      background-color: convert(k);
    }
  }

  /*
  .timeline-item-app, .timeline-item-event {
    font-weight: bold;
  }
  */
}

.timeline-body {
  width: 100%;
}

.line-anchor::after {
  content: '';
  position: absolute;
  height: 16px;
  width: 16px;
  border-radius: 50%;
  right: -9px;
  bottom: 0;
  left: -9px;
  top: 0;
  margin: auto;
  border: 2px solid $anchor-border;
}

.line-anchor {
  position: relative;
  height: 20px;
  margin: 10px 4px;
  flex: 0 0 20px;
}

.line-date, .line-title {
  flex: 1;
  display: flex;
  align-items: center;
}

.line-date {
  justify-content: flex-end;
}

.line-title .text-icon {
  margin: 0 8px;
}

.timeline-list {
  position: relative;
}

.timeline-list::before {
  position: absolute;
  content: '';
  top: -20px;
  left: 0;
  right: 0;
  bottom: -20px;
  margin: 0 auto;
  width: 2px;
  background-color: $anchor-border;
  z-index: -1;
}

.timeline-post {
  text-decoration: none;
}

.timeline-item {
  width: 100%;
  display: flex;
  padding: 20px 0;
  justify-content: flex-start;
  align-items: center;
  font-size: 18px;
  overflow: hidden;
  transition: opacity 160ms ease-out, transform 180ms $ease-out, height 200ms $ease-out, padding 200ms $ease-out;
  height: 80px;

  &-first, &-last {
    @extend .timeline-item;
    height: auto;
    padding: 0;
    justify-content: center;
  }

  &:nth-child(even) {
    flex-direction: row-reverse;

    .line-title {
      justify-content: flex-end;
    }

    .line-date {
      justify-content: flex-start;
    }
  }
}

.timeline-item--hidden {
  @extend .timeline-item;
  height: 0;
  padding: 0;
  transform: translateY(-6px);
  opacity: 0;
}

.line-anchor--now, .line-anchor--end {
  height: 40px;
  background: none;
}

.line-anchor--end::after {
  background-color: $anchor-border;
}

.line-anchor--now::after {
  border: 2px solid $anchor-border;
}

.line-date-tag {
  display: inline-block;
  font-size: 14px;
  color: #fff;
  padding: 0 4px;
  border-radius: 3px;
}

@media screen and (max-width: 1023px) {
  .wall-index {
    height: calc(100vh - 60px);
    height: calc(100dvh - 60px);
    min-height: 420px;
  }

  /* A vertical couplet needs side margin to breathe; at 390px it would sit
     under the headline, so phones keep only the falling leaves. */
  .poem {
    display: none;
  }

  .motto {
    left: 20px;
    bottom: 10%;
    font-size: 13px;
    letter-spacing: 0.28em;
  }

  .about {
    margin: 96px auto 120px;
  }

  .about-body-p {
    text-indent: 0;
  }
}

@media screen and (max-width: 415px) {
  .timeline {
    margin: 150px auto;
  }

  .timeline-list {
    .timeline-item {
      flex-direction: column;
      height: auto;
    }

    /* Filtering out a type must still collapse the row; the rule above has
       the same specificity, so repeat the hidden state after it. */
    .timeline-item--hidden {
      height: 0;
      padding: 0;
    }

    .line-date {
      border-radius: 4px;
      border: 2px solid $whitesmoke;
    }

    .line-title {
      background: white;
      border-radius: 4px;
      border: 2px solid $whitesmoke;
      padding: 4px;
    }
  }

  .about {
    margin: 72px auto 96px;
    padding: 0 18px;
  }

  .about-title {
    font-size: 30px;
    margin-bottom: 32px;
  }

  .about-body {
    font-size: 16px;
    line-height: 2;
  }
}